[
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "job_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "job_id"
    ],
    "title": "NextActionsInput",
    "type": "object"
  },
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "ActionBlocker": {
        "oneOf": [
          {
            "description": "Job is already in a terminal state; no further moves.",
            "enum": [
              "terminal"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "description": "A mandatory gate's evidence is still `NotEvaluated`.\n\n`tool_key` is `None` when the job has no materialised check for the pending gate, so there is no tool to name. It used to be a hardcoded `\"synthetic.build.validate\"`, which put a fixture string into a domain projection: a real job with no adapter behind it was told to run a tool that does not exist. The honest answer when nothing is materialised is to say so, and the handler fills this in from the store when a check does exist.",
            "properties": {
              "gate_pending": {
                "properties": {
                  "tool_key": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "gate_pending"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A mandatory gate's evidence is `Fail` and no exception is on file.",
            "properties": {
              "gate_failed": {
                "properties": {
                  "tool_key": {
                    "type": "string"
                  }
                },
                "required": [
                  "tool_key"
                ],
                "type": "object"
              }
            },
            "required": [
              "gate_failed"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "An obligation with `RequiresReview` is unsatisfied.",
            "properties": {
              "obligation_pending": {
                "properties": {
                  "reference": {
                    "type": "string"
                  }
                },
                "required": [
                  "reference"
                ],
                "type": "object"
              }
            },
            "required": [
              "obligation_pending"
            ],
            "type": "object"
          },
          {
            "description": "The active candidate has not been captured yet.",
            "enum": [
              "no_active_candidate"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "description": "The state machine refused the transition; details are in the message.",
            "properties": {
              "state_machine_blocked": {
                "type": "string"
              }
            },
            "required": [
              "state_machine_blocked"
            ],
            "type": "object"
          }
        ]
      },
      "AllowedAction": {
        "oneOf": [
          {
            "enum": [
              "capture_candidate",
              "apply_patch",
              "mark_obligation_satisfied",
              "request_approval",
              "authorize_operation",
              "publish"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "run_check": {
                "properties": {
                  "check_id": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "required": [
                  "check_id"
                ],
                "type": "object"
              }
            },
            "required": [
              "run_check"
            ],
            "type": "object"
          },
          {
            "description": "Return a job in an exceptional state to the state named by its recorded resume state (0A §21).\n\nEmitted only when such a record actually exists. The pure projection cannot know that, so the runtime attaches it from the query handler after reading the log — advertising a move that would be refused would make `allowed` a lie, and this field's documented contract is \"the `AllowedAction`s it can take *right now*\".",
            "enum": [
              "resume_job"
            ],
            "type": "string"
          }
        ]
      },
      "JobNextActions": {
        "properties": {
          "allowed": {
            "items": {
              "$ref": "#/definitions/AllowedAction"
            },
            "type": "array"
          },
          "blockers": {
            "items": {
              "$ref": "#/definitions/ActionBlocker"
            },
            "type": "array"
          },
          "job_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "allowed",
          "blockers",
          "job_id"
        ],
        "type": "object"
      }
    },
    "properties": {
      "actions": {
        "$ref": "#/definitions/JobNextActions"
      }
    },
    "required": [
      "actions"
    ],
    "title": "NextActionsOutput",
    "type": "object"
  }
]