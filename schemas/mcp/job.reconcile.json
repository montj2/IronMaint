[
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "job_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "job_id"
    ],
    "title": "ReconcileInput",
    "type": "object"
  },
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "JobState": {
        "description": "Workflow state for a [`MaintenanceJob`].\n\nPHASE-0A.md §16 lists the canonical 18-state workflow, but `CandidateAssembly` appears twice — likely a spec typo. We replace the **second** occurrence with `SourceRevision`, producing 19 distinct variants:\n\n```text EventDetected, Intake, SourceReview, CandidateAssembly, SourceRevision, SourceIntegrity, BuildValidation, PackageQaValidation, FunctionalValidation, UpgradeValidation, ReleaseReview, FinalValidation, ReadyForApproval, Approved, PublicationPending, Published, HumanReviewRequired, InfrastructureBlocked, Cancelled ```\n\n`SourceRevision` is a manual source-tweak window between the initial candidate build and the source-integrity check; an operator may edit packaging files there without invalidating the state machine. The state machine in 0A.3 will encode the rules for entering and leaving this state.",
        "oneOf": [
          {
            "description": "Initial state: a maintenance event has been detected upstream.",
            "enum": [
              "event_detected"
            ],
            "type": "string"
          },
          {
            "description": "Triaging the event: assigning it to a job and target package.",
            "enum": [
              "intake"
            ],
            "type": "string"
          },
          {
            "description": "Reviewing upstream source state (tags, commits, security feeds).",
            "enum": [
              "source_review"
            ],
            "type": "string"
          },
          {
            "description": "Producing the initial source candidate and packaging inputs.",
            "enum": [
              "candidate_assembly"
            ],
            "type": "string"
          },
          {
            "description": "Manual source-tweak window between initial build and integrity check.",
            "enum": [
              "source_revision"
            ],
            "type": "string"
          },
          {
            "description": "Verifying the source tree (checksums, signatures, provenance).",
            "enum": [
              "source_integrity"
            ],
            "type": "string"
          },
          {
            "description": "Running distribution build (sbuild / Mock) gates.",
            "enum": [
              "build_validation"
            ],
            "type": "string"
          },
          {
            "description": "Running distribution package QA (Lintian / rpmlint) gates.",
            "enum": [
              "package_qa_validation"
            ],
            "type": "string"
          },
          {
            "description": "Running functional-test gates (autopkgtest / tmt).",
            "enum": [
              "functional_validation"
            ],
            "type": "string"
          },
          {
            "description": "Running upgrade-test gates on existing installs.",
            "enum": [
              "upgrade_validation"
            ],
            "type": "string"
          },
          {
            "description": "Reviewing the assembled release metadata (changelog, notes).",
            "enum": [
              "release_review"
            ],
            "type": "string"
          },
          {
            "description": "Cross-cutting final validation before approval.",
            "enum": [
              "final_validation"
            ],
            "type": "string"
          },
          {
            "description": "All gates passed; awaiting explicit human approval.",
            "enum": [
              "ready_for_approval"
            ],
            "type": "string"
          },
          {
            "description": "Human approval recorded; cleared to publish.",
            "enum": [
              "approved"
            ],
            "type": "string"
          },
          {
            "description": "Publication side-effects proposed; awaiting authorization.",
            "enum": [
              "publication_pending"
            ],
            "type": "string"
          },
          {
            "description": "Success terminal: artifacts are in the canonical repos.",
            "enum": [
              "published"
            ],
            "type": "string"
          },
          {
            "description": "Exceptional: paused for human review (gate ambiguity, risk).",
            "enum": [
              "human_review_required"
            ],
            "type": "string"
          },
          {
            "description": "Exceptional: paused by infrastructure failure (worker / network).",
            "enum": [
              "infrastructure_blocked"
            ],
            "type": "string"
          },
          {
            "description": "Terminal: cancelled by operator or policy.",
            "enum": [
              "cancelled"
            ],
            "type": "string"
          }
        ]
      },
      "ReconcileOutcome": {
        "description": "Outcome of a `reconcile` invocation (§41).",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "The projection advanced through one or more rules and stopped on its own (terminal, exceptional, or actor-gated).",
            "properties": {
              "advanced": {
                "properties": {
                  "from": {
                    "$ref": "#/definitions/JobState"
                  },
                  "rule_index": {
                    "format": "uint",
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "to": {
                    "$ref": "#/definitions/JobState"
                  }
                },
                "required": [
                  "from",
                  "rule_index",
                  "to"
                ],
                "type": "object"
              }
            },
            "required": [
              "advanced"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The projection did not move.",
            "properties": {
              "no_op": {
                "properties": {
                  "current": {
                    "$ref": "#/definitions/JobState"
                  }
                },
                "required": [
                  "current"
                ],
                "type": "object"
              }
            },
            "required": [
              "no_op"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The next rule was blocked; the blockers are reported.",
            "properties": {
              "blocked": {
                "properties": {
                  "blockers": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "current": {
                    "$ref": "#/definitions/JobState"
                  },
                  "target": {
                    "$ref": "#/definitions/JobState"
                  }
                },
                "required": [
                  "blockers",
                  "current",
                  "target"
                ],
                "type": "object"
              }
            },
            "required": [
              "blocked"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The next rule requires an actor decision (e.g. an approval category); the runtime cannot advance without one.",
            "properties": {
              "needs_actor_decision": {
                "properties": {
                  "blockers": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "current": {
                    "$ref": "#/definitions/JobState"
                  },
                  "target": {
                    "$ref": "#/definitions/JobState"
                  }
                },
                "required": [
                  "blockers",
                  "current",
                  "target"
                ],
                "type": "object"
              }
            },
            "required": [
              "needs_actor_decision"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The job is in an exceptional state that requires external intervention.",
            "properties": {
              "exceptional": {
                "properties": {
                  "current": {
                    "$ref": "#/definitions/JobState"
                  }
                },
                "required": [
                  "current"
                ],
                "type": "object"
              }
            },
            "required": [
              "exceptional"
            ],
            "type": "object"
          },
          {
            "description": "Optimistic-concurrency contention: another writer advanced the projection between read and write. The caller should reload and retry.",
            "enum": [
              "concurrent_modification"
            ],
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "outcome": {
        "$ref": "#/definitions/ReconcileOutcome"
      }
    },
    "required": [
      "outcome"
    ],
    "title": "ReconcileOutput",
    "type": "object"
  }
]