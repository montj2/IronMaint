[
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "DistributionRef": {
        "description": "Pair of `DistributionFamily` + `DistributionRelease`.\n\nThe core represents the authority-target identity as a `family` + `release` pair. The adapter interprets the pair. Nothing here encodes Debian-vs-Fedora semantics.",
        "properties": {
          "family": {
            "type": "string"
          },
          "release": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "release"
        ],
        "type": "object"
      },
      "OrchestratorKind": {
        "oneOf": [
          {
            "enum": [
              "ironclaw",
              "human"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "other": {
                "type": "string"
              }
            },
            "required": [
              "other"
            ],
            "type": "object"
          }
        ]
      },
      "OrchestratorRef": {
        "properties": {
          "external_job": {
            "default": null,
            "description": "External job / conversation reference.",
            "type": [
              "string",
              "null"
            ]
          },
          "external_thread": {
            "default": null,
            "description": "External thread / session ID (e.g. IronClaw session id).",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/definitions/OrchestratorKind"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "PackageIdentity": {
        "description": "Identity of a package — `(distribution, source_name)`.\n\nThis is the durable key. A `PackageRevision` adds a version, but the *identity* (what distribution and what package name) is fixed by `PackageIdentity`. Equality is structural.",
        "properties": {
          "distribution": {
            "$ref": "#/definitions/DistributionRef"
          },
          "source_name": {
            "type": "string"
          }
        },
        "required": [
          "distribution",
          "source_name"
        ],
        "type": "object"
      }
    },
    "properties": {
      "orchestrator": {
        "$ref": "#/definitions/OrchestratorRef"
      },
      "package": {
        "$ref": "#/definitions/PackageIdentity"
      }
    },
    "required": [
      "orchestrator",
      "package"
    ],
    "title": "CreateJobInput",
    "type": "object"
  },
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "job_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "job_id"
    ],
    "title": "CreateJobOutput",
    "type": "object"
  }
]